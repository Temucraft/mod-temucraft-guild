[worldserver]

########################################
# mod-temucraft-guild
########################################
#
#    Temucraft.Guild.ChatHistory.Enable
#        Description: Keep every guild and officer chat line (characters DB, mod_temucraft_guild_chat, for
#                     Temucraft.Guild.KeepDays.Chat days) and send it to the Temucraft guild window.
#        Default:     1

Temucraft.Guild.ChatHistory.Enable = 1

#
#    Temucraft.Guild.ChatHistory.LoginLines
#        Description: How many of the last lines a member gets after logging in (shown in the chat window unless the
#                     player switches that off under /tui). 0 = none, at most 50.
#        Default:     10

Temucraft.Guild.ChatHistory.LoginLines = 10

#
#    Temucraft.Guild.ChatHistory.PageSize
#        Description: Lines (and log entries, news) per page the guild window and guild bank ask for (5-200).
#        Default:     50

Temucraft.Guild.ChatHistory.PageSize = 50

#
#    Temucraft.Guild.BankLogArchive.Enable
#        Description: Copy every guild bank log entry and guild event log entry into mod_temucraft_guild_bank_log
#                     and mod_temucraft_guild_event_log (for KeepDays.BankLog / .EventLog days; the core keeps the
#                     last 25 per tab), and show them
#                     in the guild bank's Log / Money Log and the guild window's Info tab.
#        Default:     1

Temucraft.Guild.BankLogArchive.Enable = 1

#
#    Temucraft.Guild.News.Enable
#        Description: Guild news (the guild window's News tab): achievements, epic items, members joining and
#                     leaving, promotions.
#        Default:     1

Temucraft.Guild.News.Enable = 1

#
#    Temucraft.Guild.News.Achievements
#    Temucraft.Guild.News.Items
#        Description: Whether achievements / looted and made items are news.
#        Default:     1

Temucraft.Guild.News.Achievements = 1
Temucraft.Guild.News.Items = 1

#
#    Temucraft.Guild.News.MinItemQuality
#        Description: Lowest item quality that is news (3 rare, 4 epic, 5 legendary; heirlooms never).
#        Default:     4

Temucraft.Guild.News.MinItemQuality = 4

#
#    Temucraft.Guild.KeepDays.Chat
#    Temucraft.Guild.KeepDays.BankLog
#    Temucraft.Guild.KeepDays.EventLog
#    Temucraft.Guild.KeepDays.News
#        Description: Days the guild chat history, the guild bank log archive, the guild log archive and the guild
#                     news keep a row. Older rows are deleted at startup and once a day (in batches, see below).
#                     0 = keep forever. A disbanded guild's rows are always deleted (and at startup those of guilds
#                     that no longer exist).
#        Default:     90, 180, 180, 365

Temucraft.Guild.KeepDays.Chat = 90
Temucraft.Guild.KeepDays.BankLog = 180
Temucraft.Guild.KeepDays.EventLog = 180
Temucraft.Guild.KeepDays.News = 365

#
#    Temucraft.Guild.Prune.BatchSize
#        Description: Rows per delete batch (100-100000); one batch goes to the database each second, so the
#                     character saves never wait behind a big delete.
#        Default:     5000

Temucraft.Guild.Prune.BatchSize = 5000
